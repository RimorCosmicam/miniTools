<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      Granted once, by hand, and never asked for again:
        adb shell pm grant com.rimor.minitools android.permission.WRITE_SECURE_SETTINGS
      Without it the switcher simply opens at the panel's native density.
    -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!--
      Optional, and the launcher works without it. It answers one sort order — "recent use" —
      and is granted in Settings rather than by a dialog; without it the grid falls back to the
      launches miniTools made itself.
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- A launcher has to be able to see what there is to launch. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".MiniToolsApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="miniTools"
        android:supportsRtl="true"
        android:theme="@style/Theme.MiniTools">

        <!-- Samsung Galaxy Z Flip cover screen / FlexWindow compatibility -->
        <meta-data
            android:name="com.samsung.android.multidisplay.keep_process_alive"
            android:value="true" />
        <meta-data
            android:name="com.samsung.android.activity.showWhenLocked"
            android:value="true" />
        <meta-data
            android:name="com.samsung.android.coverscreen.subscreen_compatible"
            android:value="true" />

        <activity
            android:name=".CoverActivity"
            android:exported="true"
            android:label="miniTools"
            android:resizeableActivity="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboardHidden"
            android:theme="@style/Theme.MiniTools">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Good Lock / MultiStar FlexWindow cover screen -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="com.samsung.android.support.COVER_SCREEN" />
            </intent-filter>
        </activity>

        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:label="miniTools Launcher"
            android:resizeableActivity="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboardHidden"
            android:theme="@style/Theme.MiniTools">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="com.samsung.android.support.COVER_SCREEN" />
            </intent-filter>
        </activity>

        <!--
          Draws nothing and lives for one call. The widget's cells launch through it because a
          collection widget's click template has to be mutable, and a mutable PendingIntent may
          not wrap an implicit intent from Android 14 onwards.
        -->
        <activity
            android:name=".LaunchTrampolineActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.MiniTools.Invisible" />

        <!-- Feeds the launcher widget's grid. -->
        <service
            android:name=".LauncherWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />

        <!-- Owns the two invisible gesture zones on the cover panel. -->
        <service
            android:name=".ToolsService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Clears a density override that outlived the process that set it. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".LauncherWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/launcher_widget_info" />
            <meta-data
                android:name="com.samsung.android.appwidget.provider"
                android:resource="@xml/samsung_cover_widget_info" />
        </receiver>

    </application>
</manifest>
